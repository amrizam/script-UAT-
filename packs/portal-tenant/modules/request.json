{
  "module": "request",
  "title": "Request teknisi",
  "scope": "Pembuatan, pemantauan, pembatalan, dan persetujuan penyelesaian request teknisi",
  "testcases": [
    {
      "key": "create",
      "scenario": "Membuat request teknisi baru dengan lampiran",
      "pre": "User sudah login sebagai {user}. Kategori request sudah diatur oleh pengelola gedung.",
      "write": true,
      "steps": [
        {"text": "Klik menu 'Request', lalu klik tombol '{t:request.create.title}'",
         "do": [{"goto": "/Complaints"}, {"click": ".mr-hero a[href*='Create']"},
                {"require": {"enabled": ".bd-submit button[type=submit]"}, "blocked": "{t:request.create.categoriesNotSet}"}]},
        {"text": "Pastikan '{t:request.create.userId}', '{t:request.create.date}', dan 'Email' terisi otomatis",
         "do": [{"record": ".rq-auto", "actual": "Field otomatis terisi: {value}."},
                {"record": "#Email", "prop": "value", "actual": "Email terisi {value}."}]},
        {"text": "Isi '{t:field.phoneNumber}' dan pilih '{t:field.unit}'",
         "do": [{"fill": "#Phone", "value": "{param.request_phone}"},
                {"if": {"js": "'{param.request_unit}'.length > 0 && !'{param.request_unit}'.startsWith('{')"}, "then": [{"select": "#Unit", "value": "{param.request_unit}"}]},
                {"save": "reqUnit", "selector": "#Unit", "prop": "value"}]},
        {"text": "Pilih '{t:field.category}' yang tersedia",
         "do": [{"eval": "const c = document.querySelector('input[name=Category]:not([disabled])'); c.click(); c.closest('label').innerText.trim()", "save": "reqCat"},
                {"record": ".cat-tiles", "js": "[...document.querySelectorAll('.cat-tile')].map(l => l.innerText.trim() + (l.classList.contains('off') ? ' (nonaktif)' : '')).join(', ')",
                 "actual": "Pilihan kategori: {value}; dipilih '{var.reqCat}'."}]},
        {"text": "Isi '{t:field.requestMessage}': {param.request_text}",
         "do": [{"fill": "#Description", "value": "{param.request_text}"}]},
        {"text": "Klik '{t:request.create.chooseFile}' dan pilih foto JPG",
         "do": [{"upload": "input[name=photos]", "files": ["files/foto_mcb_unit_0205.jpg"]},
                {"shot": "Form '{t:request.create.title}' terisi", "full": true}]},
        {"text": "Klik tombol '{t:request.create.submit}'",
         "do": [{"click": ".bd-submit button[type=submit]"},
                {"expect": {"msg": "request.create.sent"}, "save": "reqNo", "actual": "Setelah dikirim muncul '{msg}'.", "stop": true},
                {"record": ".mr-detail .mr-d-head", "actual": "My Request menampilkan {value} untuk unit {var.reqUnit}."},
                {"record": ".mr-file", "all": true, "actual": "Lampiran tersimpan: {value}."},
                {"shot": "Request terkirim – My Request", "full": true},
                {"goto": "/"},
                {"expect": {"selector": "[aria-labelledby=home-req-title]", "contains": "{var.reqNo}"}, "actual": "Request {var.reqNo} tampil di '{t:home.requests.title}' pada Home."}]}
      ],
      "expected": "Muncul pesan '{t:request.create.sent|<nomor>}'. Request tampil di My Request dengan status {t:status.waiting} dan di {t:home.requests.title} pada Home, serta diterima di sistem gedung.",
      "notes": "Data uji terkirim ke sistem gedung; isi Message / Request bertanda (UAT)."
    },
    {
      "key": "validation",
      "scenario": "Validasi field wajib dan lampiran pada form request",
      "pre": "User sudah login sebagai {user}. Form '{t:request.create.title}' terbuka.",
      "steps": [
        {"text": "Kosongkan '{t:field.phoneNumber}', '{t:field.category}', '{t:field.requestMessage}', dan lampiran, lalu klik '{t:request.create.submit}'",
         "do": [{"goto": "/Complaints/Create"},
                {"require": {"exists": "#Phone"}, "blocked": "Form request tidak tersedia untuk akun ini."},
                {"fill": "#Phone", "value": ""}, {"fill": "#Description", "value": ""},
                {"eval": "document.querySelector('form.bd-form').setAttribute('novalidate', ''); const b = document.querySelector('.bd-submit button[type=submit]'); b.disabled = false; true"},
                {"click": ".bd-submit button[type=submit]"},
                {"expect": {"text": ["{t:validation.required|{t:field.phoneNumber}}", "{t:validation.selectRequired|{t:field.category}}", "{t:validation.required|{t:field.requestMessage}}", "{t:request.file.required}"]},
                 "actual": "Muncul '{msg}'."},
                {"shot": "Pesan field wajib", "full": true}]},
        {"text": "Pilih file .zip, lalu file .pdf",
         "do": [{"upload": "input[name=photos]", "files": ["files/arsip_foto.zip"]},
                {"expect": {"text": "{t:request.file.type|*}"}, "actual": "File .zip ditolak: '{msg}'."},
                {"upload": "input[name=photos]", "files": ["files/dokumen_spesifikasi.pdf"]},
                {"expect": {"text": "{t:request.file.type|*}"}, "actual": "File .pdf ditolak: '{msg}'."}]},
        {"text": "Pilih foto berukuran 6 MB",
         "do": [{"upload": "input[name=photos]", "files": ["files/foto_besar_6mb.jpg"]},
                {"expect": {"text": "{t:request.file.tooLarge|*|2}"}, "actual": "Foto 6 MB ditolak: '{msg}'."},
                {"shot": "Penolakan lampiran", "selector": ".rq-drop", "pad": 70}]},
        {"text": "Pilih 5 file sekaligus",
         "do": [{"upload": "input[name=photos]", "files": ["files/foto_mcb_unit_0205.jpg", "files/foto_tambahan_0205.png", "files/foto_mcb_unit_0205.jpg", "files/foto_tambahan_0205.png", "files/foto_mcb_unit_0205.jpg"]},
                {"expect": {"text": "{t:request.file.tooMany|4}"}, "actual": "5 file menampilkan '{msg}'."},
                {"expect": {"count": "#thumbs > *", "max": 4}, "actual": "Hanya {value} file yang diterima."}]},
        {"text": "Klik tautan '{t:common.cancel}'",
         "do": [{"click": ".bd-foot a.back-link"}, {"expect": {"url": "/Complaints$"}, "actual": "Tautan '{t:common.cancel}' kembali ke My Request tanpa request baru."}]}
      ],
      "expected": "Request tidak terkirim dan muncul pesan validasi pada field wajib. File ditolak dengan pesan '{t:request.file.type}', '{t:request.file.tooLarge|<nama file>|2}', atau '{t:request.file.tooMany|4}'. Tautan {t:common.cancel} kembali ke My Request tanpa menyimpan data.",
      "notes": "Aplikasi hanya menerima foto JPG, JPEG, PNG; maksimal 4 file per request."
    },
    {
      "key": "monitor",
      "scenario": "Memantau status dan detail request di My Request",
      "pre": "User sudah login sebagai {user}. Tenant memiliki request.",
      "steps": [
        {"text": "Klik menu 'Request'",
         "do": [{"goto": "/Complaints"},
                {"require": {"count": ".mr-card", "min": 1}, "blocked": "Akun {user} belum memiliki request."}]},
        {"text": "Klik tab '{t:myrequest.tabs.all}', '{t:status.waiting}', '{t:status.process}', '{t:status.needApproval}', dan '{t:status.done}'",
         "do": [{"record": ".mr-tabs", "js": "[...document.querySelectorAll('.mr-tab')].map(t => t.innerText.trim().replace(/\\s+/g, ' ')).join(', ')", "actual": "Tab menampilkan {value}."},
                {"click": ".mr-tab[href*='tab=done']"},
                {"record": ".mr-list", "actual": "Tab '{t:status.done}' menampilkan: {value}."},
                {"click": ".mr-tab[href$='/Complaints']"}]},
        {"text": "Pilih request teratas pada daftar",
         "do": [{"click": ".mr-card"}, {"record": ".mr-d-head", "actual": "Panel detail menampilkan {value}."}]},
        {"text": "Periksa '{t:myrequest.detail.worker}', '{t:myrequest.detail.startDate}', '{t:myrequest.detail.targetDate}', '{t:myrequest.detail.action}', lampiran, dan '{t:myrequest.detail.progress}'",
         "do": [{"record": ".mr-facts", "actual": "{value}."},
                {"record": ".mr-steps", "js": "[...document.querySelectorAll('.mr-steps .mr-step')].map(s => s.querySelector('.mr-step-body').innerText.split('\\n')[0].trim() + ' (' + (s.className.match(/done|current|pending|cancelled/) || [''])[0] + ')').join(' → ')",
                 "actual": "Timeline '{t:myrequest.detail.progress}': {value}."},
                {"shot": "My Request dan panel detail", "full": true}]},
        {"text": "Klik lampiran untuk membuka file",
         "do": [{"if": {"exists": ".mr-file"},
                 "then": [{"save": "attHref", "selector": ".mr-file", "attr": "href"},
                          {"expect": {"fetch": "{var.attHref}", "status": 200, "type": "image/"}, "actual": "Lampiran terbuka sebagai gambar ({r_type}, {r_size} byte)."}],
                 "else": [{"actual": "Request teratas tidak memiliki lampiran."}]}]}
      ],
      "expected": "Jumlah pada setiap tab sesuai data dan daftar terfilter sesuai status. Panel detail menampilkan petugas, tanggal, tindakan, lampiran yang dapat dibuka, dan timeline {t:myrequest.detail.progress}."
    },
    {
      "key": "photo-cancel",
      "scenario": "Menambah foto dan membatalkan request yang belum diproses",
      "pre": "User sudah login sebagai {user}. Kategori request sudah diatur.",
      "write": true,
      "steps": [
        {"text": "Buat request uji untuk pembatalan",
         "do": [{"goto": "/Complaints/Create"},
                {"require": {"enabled": ".bd-submit button[type=submit]"}, "blocked": "{t:request.create.categoriesNotSet}"},
                {"fill": "#Phone", "value": "{param.request_phone}"},
                {"eval": "document.querySelector('input[name=Category]:not([disabled])').click(); true"},
                {"fill": "#Description", "value": "Lampu darurat di koridor tidak menyala. (UAT – request untuk uji pembatalan)"},
                {"upload": "input[name=photos]", "files": ["files/foto_mcb_unit_0205.jpg"]},
                {"click": ".bd-submit button[type=submit]"},
                {"expect": {"msg": "request.create.sent"}, "save": "cancelNo", "actual": "Request uji {var.cancelNo} terkirim dengan status '{t:status.waiting}'.", "stop": true},
                {"shot": "Request uji untuk pembatalan", "selector": ".mr-detail", "pad": 12}]},
        {"text": "Pada detail request, klik tautan '{t:myrequest.manage.photoOrCancel}'",
         "do": [{"click": ".mr-manage"}, {"expect": {"exists": "#photo"}, "actual": "Halaman detail request {var.cancelNo} terbuka.", "stop": true}]},
        {"text": "Pilih foto PNG lalu klik '{t:complaint.photo.upload}'",
         "do": [{"upload": "#photo", "files": ["files/foto_tambahan_0205.png"]},
                {"click": "form[action*='AddPhoto'] button[type=submit]"},
                {"expect": {"msg": "complaint.photo.added"}, "actual": "Foto tersimpan dengan pesan '{msg}'."},
                {"shot": "'{t:complaint.photo.added}'", "full": true}]},
        {"text": "Klik '{t:complaint.cancel.submit}', lalu konfirmasi",
         "do": [{"click": "form[action*='Cancel'] button[type=submit]"},
                {"expect": {"msg": "complaint.cancel.done"}, "actual": "Setelah konfirmasi muncul '{msg}'."},
                {"expect": {"js": "!document.body.innerText.includes('{var.cancelNo}') || location.pathname.endsWith('/Complaints')"}, "actual": "Request {var.cancelNo} tidak tampil lagi di My Request."},
                {"shot": "Request dibatalkan", "full": true}]}
      ],
      "expected": "Foto tersimpan dengan pesan '{t:complaint.photo.added}' dan jumlah foto bertambah. Request dibatalkan dengan pesan '{t:complaint.cancel.done|<nomor>}' dan tidak tampil lagi di daftar.",
      "notes": "Request uji dibuat lalu dibatalkan pada skenario yang sama."
    },
    {
      "key": "approve",
      "scenario": "Menyetujui penyelesaian request",
      "pre": "Request berstatus {t:status.needApproval} (pekerjaan sudah dilaporkan selesai oleh departemen terkait).",
      "write": true,
      "steps": [
        {"text": "Klik menu 'Request', lalu klik tab '{t:status.needApproval}'",
         "do": [{"goto": "/Complaints?tab=needApproval"},
                {"require": {"count": ".mr-card", "min": 1}, "blocked": "Belum ada request berstatus '{t:status.needApproval}' (WR/WO harus diproses dan dilaporkan selesai di sistem gedung)."}]},
        {"text": "Pilih request yang akan dikonfirmasi dan cek hasil pekerjaan di unit",
         "do": [{"save": "apprNo", "selector": ".mr-d-no"}, {"shot": "Request menunggu persetujuan", "full": true}]},
        {"text": "Klik tombol '{t:myrequest.confirm.approve}'",
         "do": [{"click": "button[form='mr-approve']"},
                {"expect": {"msg": "myrequest.confirm.approved"}, "actual": "Muncul pesan '{msg}'."},
                {"shot": "Penyelesaian disetujui", "full": true}]}
      ],
      "expected": "Muncul pesan '{t:myrequest.confirm.approved|<nomor>}'. Status request menjadi {t:status.done} dan status di sistem gedung ikut berubah."
    },
    {
      "key": "not-yet",
      "scenario": "Menolak penyelesaian request ({t:myrequest.confirm.notYet})",
      "pre": "Request berstatus {t:status.needApproval}.",
      "write": true,
      "steps": [
        {"text": "Klik menu 'Request', lalu klik tab '{t:status.needApproval}'",
         "do": [{"goto": "/Complaints?tab=needApproval"},
                {"require": {"count": ".mr-card", "min": 1}, "blocked": "Belum ada request berstatus '{t:status.needApproval}' (WR/WO harus diproses dan dilaporkan selesai di sistem gedung)."}]},
        {"text": "Isi '{t:myrequest.confirm.noteLabel}' (opsional, maks. 500 karakter)",
         "do": [{"fill": "#mr-note", "value": "Hasil pekerjaan belum sesuai (UAT)."}]},
        {"text": "Klik tombol '{t:myrequest.confirm.notYet}', lalu konfirmasi pada dialog",
         "do": [{"click": "button[form='mr-notyet']"},
                {"expect": {"msg": "myrequest.confirm.notYetSent"}, "actual": "Muncul pesan '{msg}'."},
                {"shot": "Request ditandai belum sesuai", "full": true}]}
      ],
      "expected": "Muncul pesan '{t:myrequest.confirm.notYetSent|<nomor>}'. Request kembali ke status {t:status.process} dan timeline mencatat catatan tenant."
    }
  ]
}
