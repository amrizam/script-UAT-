{
  "module": "home",
  "title": "Home & navigasi",
  "scope": "Dashboard Home, pemilih unit, dan navigasi antar menu",
  "testcases": [
    {
      "key": "dashboard",
      "scenario": "Menampilkan Dashboard Home",
      "pre": "User sudah login sebagai {user}. Tenant memiliki data unit, tagihan, request, dan jadwal.",
      "steps": [
        {"text": "Klik menu 'Home'", "do": [{"goto": "/"}, {"expect": {"visible": ".home-hero"}, "actual": "Halaman Home tampil.", "stop": true}]},
        {"text": "Periksa kartu '{t:home.unit.title}'",
         "do": [{"record": ".home-unit .kv-rows", "actual": "Kartu '{t:home.unit.title}' menampilkan: {value}."}]},
        {"text": "Periksa kartu tagihan outstanding beserta daftar invoice belum dibayar",
         "do": [{"record": ".home-bill-main", "actual": "Kartu tagihan menampilkan: {value}."},
                {"save": "homeTotal", "selector": ".home-bill .bill-total"},
                {"record": ".home-bill .bill-list", "all": true, "actual": "Invoice teratas: {value}."},
                {"shot": "Halaman Home", "full": true},
                {"save": "homeUnit", "selector": ".home-unit .kv-rows div:last-child dd"},
                {"goto": "/Billing"},
                {"save": "billTotal", "selector": "[aria-labelledby=bill-total-title] .bill-card-value"},
                {"expect": {"js": "'{var.homeTotal}' === '{var.billTotal}'"},
                 "actual": "Total di Home ({var.homeTotal}) sama dengan kartu '{t:billing.outstanding.title}' di Billing ({var.billTotal}).",
                 "fail": "Total di Home ({var.homeTotal}) berbeda dengan '{t:billing.outstanding.title}' di Billing ({var.billTotal})."},
                {"goto": "/"}]},
        {"text": "Periksa daftar '{t:home.requests.title}'",
         "do": [{"record": "[aria-labelledby=home-req-title] .list, [aria-labelledby=home-req-title] .empty", "actual": "'{t:home.requests.title}': {value}."}]},
        {"text": "Periksa daftar '{t:home.schedule.title}'",
         "do": [{"record": ".home-schedule .list, .home-schedule .empty", "actual": "'{t:home.schedule.title}': {value}."}]}
      ],
      "expected": "Informasi unit tampil sesuai data Tenancy. Total tagihan outstanding dan jumlah invoice belum dibayar sama dengan kartu Total outstanding di menu Billing, termasuk peringatan jatuh tempo terdekat. {t:home.requests.title} dan {t:home.schedule.title} (overtime dan booking) tampil dengan status yang benar.",
      "notes": "Nominal tagihan mengikuti data Finance (vw_ipl_list) – periksa kesesuaiannya dengan Finance."
    },
    {
      "key": "unit-picker",
      "scenario": "Mengganti unit aktif melalui pemilih unit",
      "pre": "User sudah login sebagai {user} dan tenant memiliki lebih dari satu unit.",
      "steps": [
        {"text": "Klik pemilih unit pada header",
         "do": [{"goto": "/"},
                {"require": {"count": ".hdr-top details.hdr-unit button[name=unit]", "min": 2}, "blocked": "Akun {user} hanya memiliki satu unit sehingga pemilih unit tidak dapat diuji."},
                {"click": ".hdr-top details.hdr-unit summary", "settle": false}, {"wait": 300},
                {"record": ".hdr-top details.hdr-unit .menu", "actual": "Daftar '{t:header.chooseUnit}' menampilkan: {value}."},
                {"shot": "Daftar '{t:header.chooseUnit}' pada header", "clip": [566, 0, 800, 260]}]},
        {"text": "Pilih unit lain pada daftar '{t:header.chooseUnit}', lalu kembali ke unit semula",
         "do": [{"eval": "[...document.querySelectorAll('.hdr-top details.hdr-unit button[name=unit]')].find(b => !b.classList.contains('active')).value", "save": "unitOther"},
                {"eval": "document.querySelector('.hdr-top details.hdr-unit button[name=unit].active').value", "save": "unitStart"},
                {"eval": "[...document.querySelectorAll('.hdr-top details.hdr-unit button[name=unit]')].find(b => b.value === '{var.unitOther}').click(); true", "settle": true},
                {"expect": {"selector": ".hdr-top details.hdr-unit summary", "contains": "{var.unitOther}"},
                 "actual": "Setelah memilih {var.unitOther}, header menampilkan '{value}'."},
                {"expect": {"selector": ".home-unit", "contains": "{var.unitOther}"}, "actual": "Kartu '{t:home.unit.title}' ikut berubah ke unit {var.unitOther}."},
                {"shot": "Home setelah unit {var.unitOther} dipilih"}]},
        {"text": "Buka form '{t:request.create.title}', form '{t:overtime.form.title}', dan menu 'Billing'",
         "do": [{"goto": "/Complaints/Create"},
                {"expect": {"js": "!document.querySelector('#Unit') || document.querySelector('#Unit').value === '{var.unitOther}'"},
                 "actual": "Field '{t:field.unit}' pada '{t:request.create.title}' terisi {var.unitOther}."},
                {"goto": "/Overtime"},
                {"expect": {"js": "!document.querySelector('#Unit') || document.querySelector('#Unit').value === '{var.unitOther}'"},
                 "actual": "Field '{t:field.unit}' pada '{t:overtime.form.title}' terisi {var.unitOther}."},
                {"goto": "/Billing"},
                {"expect": {"js": "document.querySelector('#f-unit').value === '{var.unitOther}'"},
                 "actual": "Filter '{t:field.unit}' di Billing terisi {var.unitOther}."},
                {"goto": "/"},
                {"eval": "[...document.querySelectorAll('.hdr-top details.hdr-unit button[name=unit]')].find(b => b.value === '{var.unitStart}').click(); true", "settle": true}]}
      ],
      "expected": "Pemilih unit menampilkan unit yang dipilih dan kartu {t:home.unit.title} mengikuti unit tersebut. Nilai default field Unit pada form request, overtime, dan filter Billing mengikuti unit aktif."
    },
    {
      "key": "navigation",
      "scenario": "Navigasi menu utama dan pintasan layanan",
      "pre": "User sudah login sebagai {user}.",
      "steps": [
        {"text": "Klik menu 'Home', 'Request', 'Billing', 'Overtime', dan 'Booking' secara bergantian",
         "do": [{"goto": "/"},
                {"click": ".hdr-nav a[href$='/Complaints']"}, {"expect": {"url": "/Complaints"}, "actual": "Request → '{t:request.myRequest}'."},
                {"click": ".hdr-nav a[href$='/Billing']"}, {"expect": {"url": "/Billing"}, "actual": "Billing → 'Estate Billing Information'."},
                {"click": ".hdr-nav a[href$='/Overtime']"}, {"expect": {"url": "/Overtime"}, "actual": "Overtime → 'Overtime'."},
                {"click": ".hdr-nav a[href$='/Booking']"}, {"expect": {"url": "/Booking"}, "actual": "Booking → '{t:booking.title}'."},
                {"expect": {"selector": ".hdr-nav a.active", "contains": "Booking"}, "actual": "Menu yang sedang aktif ditandai pada header."},
                {"click": ".hdr-nav a[href$='/']"}, {"expect": {"visible": ".home-hero"}, "actual": "Home → halaman Home."}]},
        {"text": "Klik tautan '{t:quick.booking.link}', '{t:quick.request.link}', '{t:quick.overtime.link}', dan '{t:quick.billing.link}' pada bagian '{t:home.quick.title}'",
         "do": [{"shot": "Bagian '{t:home.quick.title}' di Home", "selector": "#home-quick-title + .quick-cards", "pad": 40},
                {"click": ".quick-cards a[href$='/Booking']"}, {"expect": {"url": "/Booking"}, "actual": "'{t:quick.booking.link}' → '{t:booking.title}'."}, {"goto": "/"},
                {"click": ".quick-cards a[href*='/Complaints/Create']"}, {"expect": {"url": "/Complaints/Create"}, "actual": "'{t:quick.request.link}' → '{t:request.create.title}'."}, {"goto": "/"},
                {"click": ".quick-cards a[href$='/Overtime']"}, {"expect": {"url": "/Overtime"}, "actual": "'{t:quick.overtime.link}' → 'Overtime'."}, {"goto": "/"},
                {"click": ".quick-cards a[href$='/Billing']"}, {"expect": {"url": "/Billing"}, "actual": "'{t:quick.billing.link}' → 'Estate Billing Information'."}]},
        {"text": "Klik tombol '{t:billing.summary.view}', tautan '{t:common.viewAll}', dan tombol '{t:home.schedule.newBooking}'",
         "do": [{"goto": "/"}, {"click": "a.home-bill-btn"}, {"expect": {"url": "/Billing"}, "actual": "'{t:billing.summary.view}' → Estate Billing Information."},
                {"goto": "/"}, {"click": "[aria-labelledby=home-req-title] .card-head a"}, {"expect": {"url": "/Complaints"}, "actual": "'{t:common.viewAll}' → '{t:request.myRequest}'."},
                {"goto": "/"}, {"click": ".home-schedule a.btn"}, {"expect": {"url": "/Booking"}, "actual": "'{t:home.schedule.newBooking}' → '{t:booking.title}'."}]},
        {"text": "Klik tautan 'Home' pada breadcrumb di halaman Billing",
         "do": [{"goto": "/Billing"}, {"click": ".breadcrumb a"}, {"expect": {"visible": ".home-hero"}, "actual": "Breadcrumb 'Home' kembali ke halaman Home."}]}
      ],
      "expected": "Setiap menu dan tautan membuka halaman yang benar dan menu yang sedang aktif ditandai pada header."
    }
  ]
}
